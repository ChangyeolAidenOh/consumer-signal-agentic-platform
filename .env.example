# PostgreSQL (local development via docker-compose)
POSTGRES_DB=hns_platform
POSTGRES_USER=hns_user
POSTGRES_PASSWORD=hns_local_dev_only
DATABASE_URL=postgresql://hns_user:hns_local_dev_only@localhost:5437/hns_platform

# LLM provider: ollama | gemini | anthropic
LLM_PROVIDER=ollama

# Ollama (when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Google AI Studio (when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=

# Anthropic (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
